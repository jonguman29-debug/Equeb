<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Admin Dashboard - Digital Equb</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6f9;
      color: #172033;
    }

    header {
      background: #111827;
      color: white;
      padding: 18px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 21px;
      font-weight: bold;
    }

    .logout {
      background: #ef4444;
      color: white;
      text-decoration: none;
      padding: 9px 14px;
      border-radius: 8px;
      font-size: 14px;
    }

    .container {
      max-width: 1200px;
      margin: auto;
      padding: 25px 20px;
    }

    .welcome {
      margin-bottom: 25px;
    }

    .welcome h1 {
      font-size: 28px;
      margin-bottom: 7px;
    }

    .welcome p {
      color: #667085;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 18px;
      margin-bottom: 30px;
    }

    .card {
      background: white;
      padding: 22px;
      border-radius: 15px;
      box-shadow: 0 5px 18px rgba(0,0,0,0.07);
    }

    .icon {
      font-size: 28px;
      margin-bottom: 12px;
    }

    .card h3 {
      font-size: 14px;
      color: #667085;
      margin-bottom: 8px;
    }

    .value {
      font-size: 25px;
      font-weight: bold;
    }

    .section {
      background: white;
      padding: 24px;
      border-radius: 15px;
      margin-bottom: 20px;
      box-shadow: 0 5px 18px rgba(0,0,0,0.06);
    }

    .section h2 {
      font-size: 20px;
      margin-bottom: 18px;
    }

    .actions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 15px;
    }

    .action {
      border: none;
      padding: 17px;
      border-radius: 10px;
      background: #f5b942;
      color: #111827;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    .action:hover {
      opacity: 0.9;
    }

    .action.blue {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .action.green {
      background: #dcfce7;
      color: #166534;
    }

    .action.red {
      background: #fee2e2;
      color: #b91c1c;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      padding: 14px 10px;
      text-align: left;
      border-bottom: 1px solid #eee;
    }

    th {
      color: #667085;
      font-size: 13px;
    }

    .status {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: bold;
    }

    .paid {
      background: #dcfce7;
      color: #166534;
    }

    .unpaid {
      background: #fee2e2;
      color: #b91c1c;
    }

    .active {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .draw-box {
      text-align: center;
      padding: 25px;
      background: #fff8e1;
      border-radius: 12px;
    }

    .draw-number {
      font-size: 45px;
      font-weight: bold;
      margin: 10px 0;
      color: #b7791f;
    }

    .draw-btn {
      border: none;
      background: #111827;
      color: white;
      padding: 13px 22px;
      border-radius: 9px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 15px;
    }

    .draw-btn:hover {
      background: #243b55;
    }

    @media (max-width: 650px) {
      .section {
        overflow-x: auto;
      }

      table {
        min-width: 650px;
      }

      .welcome h1 {
        font-size: 24px;
      }
    }
  </style>
</head>

<body>

  <header>

    <div class="logo">
      👑 Digital Equb Admin
    </div>

    <a href="login.html" class="logout">
      Logout
    </a>

  </header>

  <main class="container">

    <div class="welcome">
      <h1>Admin Dashboard 👋</h1>
      <p>Manage your Digital Equb from one place.</p>
    </div>

    <!-- Statistics -->

    <div class="cards">

      <div class="card">
        <div class="icon">👥</div>
        <h3>Total Members</h3>
        <div class="value">120</div>
      </div>

      <div class="card">
        <div class="icon">💰</div>
        <h3>Total Contributions</h3>
        <div class="value">240,000 ETB</div>
      </div>

      <div class="card">
        <div class="icon">✅</div>
        <h3>Paid Members</h3>
        <div class="value">112</div>
      </div>

      <div class="card">
        <div class="icon">⚠️</div>
        <h3>Unpaid Members</h3>
        <div class="value">8</div>
      </div>

    </div>

    <!-- Quick Actions -->

    <div class="section">

      <h2>⚡ Quick Actions</h2>

      <div class="actions">

        <button class="action">
          ➕ Add Member
        </button>

        <button class="action blue">
          💳 Record Payment
        </button>

        <button class="action green">
          📊 View Reports
        </button>

        <button class="action red">
          👥 Manage Members
        </button>

      </div>

    </div>

    <!-- Current Draw -->

    <div class="section">

      <h2>🎯 Current Equb Draw</h2>

      <div class="draw-box">

        <p>Current Round</p>

        <div class="draw-number">
          #12
        </div>

        <p>
          Current winner:
          <strong>Not selected</strong>
        </p>

        <button class="draw-btn" onclick="startDraw()">
          🎲 Start Digital Draw
        </button>

      </div>

    </div>

    <!-- Members -->

    <div class="section">

      <h2>👥 Recent Members</h2>

      <table>

        <thead>
          <tr>
            <th>Member ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Contribution</th>
            <th>Status</th>
          </tr>
        </thead>

        <tbody>

          <tr>
            <td>EQB-001</td>
            <td>Abebe</td>
            <td>09XXXXXXXX</td>
            <td>1,000 ETB</td>
            <td>
              <span class="status paid">Paid</span>
            </td>
          </tr>

          <tr>
            <td>EQB-002</td>
            <td>Meron</td>
            <td>09XXXXXXXX</td>
            <td>1,000 ETB</td>
            <td>
              <span class="status unpaid">Unpaid</span>
            </td>
          </tr>

          <tr>
            <td>EQB-003</td>
            <td>Dawit</td>
            <td>09XXXXXXXX</td>
            <td>1,000 ETB</td>
            <td>
              <span class="status paid">Paid</span>
            </td>
          </tr>

          <tr>
            <td>EQB-004</td>
            <td>Selam</td>
            <td>09XXXXXXXX</td>
            <td>1,000 ETB</td>
            <td>
              <span class="status active">Active</span>
            </td>
          </tr>

        </tbody>

      </table>

    </div>

  </main>

  <script>

    function startDraw() {

      const confirmed = confirm(
        "Are you sure you want to start the digital draw?"
      );

      if (confirmed) {

        alert(
          "Digital draw started! The winner will be selected."
        );

      }

    }

  </script>

</body>
</html>
