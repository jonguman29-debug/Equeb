<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Digital Equb</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    header {
      background: #111827;
      color: white;
      padding: 18px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
    }

    .login-btn {
      background: #f5b942;
      color: #111827;
      text-decoration: none;
      padding: 10px 16px;
      border-radius: 8px;
      font-weight: bold;
    }

    .hero {
      padding: 70px 20px;
      text-align: center;
      background: linear-gradient(135deg, #111827, #243b55);
      color: white;
    }

    .hero h1 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      line-height: 1.6;
      max-width: 600px;
      margin: auto;
      color: #dbe3ef;
    }

    .start-btn {
      display: inline-block;
      margin-top: 28px;
      padding: 14px 25px;
      background: #f5b942;
      color: #111827;
      text-decoration: none;
      border-radius: 10px;
      font-weight: bold;
    }

    .features {
      padding: 45px 20px;
      max-width: 1000px;
      margin: auto;
    }

    .features h2 {
      text-align: center;
      margin-bottom: 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      color: #667085;
      line-height: 1.5;
    }

    footer {
      text-align: center;
      padding: 25px;
      background: #111827;
      color: #aaa;
      margin-top: 30px;
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">💰 Digital Equb</div>
    <a href="#" class="login-btn">Login</a>
  </header>

  <section class="hero">
    <h1>Digital Equb</h1>

    <p>
      A simple and secure way to manage your Equb,
      members, contributions and turns digitally.
    </p>

    <a href="#" class="start-btn">Get Started</a>
  </section>

  <section class="features">

    <h2>Everything in One Place</h2>

    <div class="cards">

      <div class="card">
        <h3>👥 Members</h3>
        <p>
          Easily manage Equb members and their information.
        </p>
      </div>

      <div class="card">
        <h3>💰 Contributions</h3>
        <p>
          Track payments and contribution history.
        </p>
      </div>

      <div class="card">
        <h3>🎯 Digital Turns</h3>
        <p>
          Manage Equb turns and winners digitally.
        </p>
      </div>

      <div class="card">
        <h3>📊 Dashboard</h3>
        <p>
          See important Equb information from one dashboard.
        </p>
      </div>

    </div>

  </section>

  <footer>
    © 2026 Digital Equb. All rights reserved.
  </footer>

</body>
</html>
